{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @franco/dual-brain-guard pre-tool"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @franco/dual-brain-guard post-tool"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes @franco/dual-brain-guard stop"
          }
        ]
      }
    ]
  }
}
